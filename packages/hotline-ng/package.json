{
  "name": "@hotline-ng/client",
  "version": "0.1.0",
  "description": "A TypeScript client for the Hotline-ng wire: one session across however many WebSockets it takes, plus the voice and video the SFU serves.",
  "license": "GPL-2.0-or-later",
  "type": "module",
  "sideEffects": false,
  "keywords": [
    "hotline",
    "hotline-ng",
    "hxd",
    "websocket",
    "webrtc",
    "sfu",
    "chat"
  ],
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mishan/hx-ng.git",
    "directory": "packages/hotline-ng"
  },
  "publishConfig": {
    "access": "public"
  }
}
