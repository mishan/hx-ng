{
  // The library's Node subpath and its test: Node's types, with DOM for
  // the library modules they import, which are written against
  // WebCrypto's and fetch's DOM typings. Not `tsconfig.node.json`,
  // whose e2e specs would read DOM as the page's.
  "extends": "./tsconfig.node.json",
  "compilerOptions": {
    "lib": [
      "ES2022",
      "DOM"
    ]
  },
  "include": [
    "packages/hotline-ng/src/node.ts",
    "packages/hotline-ng/test/node.test.ts"
  ]
}
